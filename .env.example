# ---------------------------------------------------------------------------
# Arkham configuration template. Copy to .env and fill in real values.
# .env is git-ignored. NEVER commit credentials. Placeholders below are empty.
# ---------------------------------------------------------------------------

# --- Delivery schedule --------------------------------------------------------
ARKHAM_TIMEZONE=America/New_York
ARKHAM_DELIVERY_HOUR=8

# --- Delivery transport --------------------------------------------------------
# discord (default, free: a standard incoming webhook, no bot token, no server)  |  twilio (legacy SMS, paid)
ARKHAM_DELIVERY_PROVIDER=discord

# Discord incoming webhook for your PRIVATE Arkham channel:
#   Server Settings -> Integrations -> Webhooks -> New Webhook -> pick the channel -> Copy Webhook URL
# Treat this URL like a password: anyone holding it can post into that channel. Never paste it into
# source code or a public log; put it here locally and in the GitHub Actions secret DISCORD_WEBHOOK_URL.
# Verify it with: python -m arkham test-delivery   (sends ONE small labelled message, never automatic)
DISCORD_WEBHOOK_URL=

# --- Legacy Twilio SMS (only read when ARKHAM_DELIVERY_PROVIDER=twilio; not required otherwise) ------
# ARKHAM_TO_PHONE: your number in E.164 form, e.g. +12125551234 (the only number Arkham will message).
# Twilio credentials: https://console.twilio.com -> Account Info; Phone Numbers -> Manage.
ARKHAM_TO_PHONE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# --- NVD API 2.0 key (optional but recommended: https://nvd.nist.gov/developers/request-an-api-key)
# Without a key NVD allows 5 requests / 30 s; Arkham needs 1-3 requests per run.
NVD_API_KEY=

# --- LLM analyst ---------------------------------------------------------------
# LLM_PROVIDER: gemini | openai | anthropic | template
#   gemini    -> Google Gemini through its OpenAI-compatible endpoint (GEMINI_API_KEY; optional GEMINI_BASE_URL).
#                Intended production model. Same hardened provider code as `openai`; only endpoint/key differ.
#   openai    -> any OpenAI-compatible Chat Completions API (OPENAI_API_KEY, optional OPENAI_BASE_URL)
#   anthropic -> Anthropic Messages API (ANTHROPIC_API_KEY)
#   template  -> deterministic evidence-only renderer, no API call, no cost (useful for the first dry run)
# LLM_MODEL is REQUIRED for API providers and is deliberately not defaulted:
# model names get deprecated, so pick a current inexpensive model id from your provider's docs
# (for Gemini: https://ai.google.dev/gemini-api/docs/models).
LLM_PROVIDER=gemini
LLM_MODEL=
# Per-attempt model-call timeout only; source/feed HTTP timeouts are unchanged.
ARKHAM_LLM_TIMEOUT_SECONDS=180
# Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Only set to point at a different OpenAI-compatible Gemini endpoint; default is Google's.
GEMINI_BASE_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=

# --- LLM pricing (USD per 1M tokens) used ONLY for the cost report. Not defaulted:
# copy the current numbers from your provider's pricing page. Leave blank to report "unpriced".
LLM_INPUT_PRICE_PER_1M=
LLM_OUTPUT_PRICE_PER_1M=

# --- SMS pricing (USD per segment; legacy Twilio transport only). Discord webhooks are free.
SMS_PRICE_PER_SEGMENT=

# --- Briefing shape --------------------------------------------------------------
ARKHAM_MAX_EVENTS=8
# Minimum deterministic priority score for an event to be briefed (0-100 scale; default 35)
ARKHAM_MIN_PRIORITY_SCORE=
# Legacy SMS-only settings (ignored by the Discord transport, which has no character budget):
ARKHAM_MAX_SMS_CHARS=900
ARKHAM_SMS_EMOJI=false

# --- Collection window ----------------------------------------------------------
# Hours to look back when there is no previous successful run (default 24, max 168)
ARKHAM_LOOKBACK_HOURS=24

# --- Native Arkham Crawl -------------------------------------------------------
# Deterministic, offline extraction + one hardened HTTPS fetch per URL (robots.txt respected). No crawler
# account, API key, browser or JavaScript. Bounds used by arkham.crawl.fetcher / extract:
ARKHAM_CRAWL_HTTP_MAX_BYTES=4194304
ARKHAM_CRAWL_MAX_TEXT_CHARS=50000
ARKHAM_CRAWL_RETRIES=2
ARKHAM_CRAWL_MAX_RETRY_AFTER_SECONDS=30
ARKHAM_CRAWL_ROBOTS_CACHE_HOURS=24
ARKHAM_CRAWL_ROBOTS_FAILURE_CACHE_MINUTES=30
ARKHAM_CRAWL_QUALITY_THRESHOLD=0.62
# Validated but reserved for the (not yet built) scheduled crawl service and Level-2 renderer; v1 ignores them.
ARKHAM_CRAWL_ENABLED=true
ARKHAM_CRAWL_GLOBAL_CONCURRENCY=6
ARKHAM_CRAWL_PER_DOMAIN_CONCURRENCY=1
ARKHAM_CRAWL_DOMAIN_DELAY_SECONDS=0.25
ARKHAM_CRAWL_FEED_MIN_CHARS=600
ARKHAM_CRAWL_PREFETCH_MIN_SCORE=20
ARKHAM_CRAWL_BROWSER_ENABLED=false
ARKHAM_CRAWL_BROWSER_CONCURRENCY=1
ARKHAM_CRAWL_BROWSER_TIMEOUT_SECONDS=15

# --- Storage / logging ------------------------------------------------------------
ARKHAM_DB_PATH=data/arkham.db
ARKHAM_LOG_LEVEL=INFO
# text | json
ARKHAM_LOG_FORMAT=text
# Comma-separated source ids to disable (see `python -m arkham sources`)
ARKHAM_DISABLED_SOURCES=
